# Copy to .env and adjust.

# Directory holding your build tree(s), mounted at /workspace/build
AM_BUILD_ROOT=/path/to/build

# Checkout of https://github.com/RMerl/am-toolchains
AM_TOOLCHAINS=/path/to/am-toolchains

# Your host user/group IDs (output of `id -u` and `id -g`)
BUILD_UID=1000
BUILD_GID=1000

# Container time zone
TZ=UTC

# Optional: use a different image name (e.g. for a fork)
#IMAGE_NAME=ghcr.io/asuswrt-merlin/fw-build
